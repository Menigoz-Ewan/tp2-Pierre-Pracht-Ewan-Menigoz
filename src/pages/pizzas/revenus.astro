---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import pizzasData from "../../data/pizzas.json";
import Layout from "../../layouts/Layout.astro";

const revenusOptions = {
    title: "Revenu total par catégorie",
    subtitle: "Cumul des revenus en dollars par type de pizza",
    ariaLabel: "Diagramme en barres des revenus par catégorie de pizza.",
    marginLeft: 80,
    x: { label: "Catégorie" },
    y: { label: "↑ Revenu total ($)" },
    color: {
        domain: ["Classic", "Specialty", "Vegetarian"],
        range: ["#570df8", "#f000b8", "#37cdbe"],
    },
    marks: [
        Plot.barY(
            pizzasData,
            Plot.groupX(
                { y: "sum" },
                { x: "category", y: "revenue", fill: "category" },
            ),
        ),
        Plot.ruleY([0]),
    ],
};
---

<Layout>
    <div style="margin-bottom: 1.5rem;">
        <a
            href="/pizzas"
            style="text-decoration: none; color: #3182ce; font-weight: bold; font-size: 0.95rem;"
            >← Retour aux Pizzas</a
        >
    </div>

    <h1
        style="text-align: center; margin-bottom: 2rem; font-size: 2rem; font-weight: bold;"
    >
        Revenus par catégorie
    </h1>

    <figure
        style="display: flex; flex-direction: column; align-items: center; gap: 1rem;"
    >
        <PlotFigure options={revenusOptions} />
        <figcaption
            style="max-width: 700px; text-align: center; font-size: 0.95rem; color: #555; line-height: 1.5;"
        >
            Ce diagramme montre le revenu total cumulé pour chaque catégorie de
            pizza sur l'année 2020. Chaque barre représente la somme de tous les
            revenus générés par les pizzas de cette catégorie.
        </figcaption>
    </figure>

    <div
        style="display: flex; justify-content: flex-end; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;"
    >
        <a
            href="/pizzas/jours"
            style="text-decoration: none; color: #3182ce; font-weight: bold;"
            >Article suivant →</a
        >
    </div>
</Layout>
