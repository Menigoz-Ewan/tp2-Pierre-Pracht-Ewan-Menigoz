---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import pizzasData from "../../data/pizzas.json";
import Layout from "../../layouts/Layout.astro";

const joursOrdre = [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
];

const joursOptions = {
    title: "Commandes par jour de la semaine",
    subtitle: "Nombre total de commandes selon le jour",
    ariaLabel: "Diagramme en barres des commandes par jour de la semaine.",
    x: {
        label: "Jour de la semaine",
        domain: joursOrdre,
    },
    y: { label: "↑ Nombre de commandes" },
    color: { scheme: "tableau10" },
    marks: [
        Plot.barY(
            pizzasData,
            Plot.groupX(
                { y: "sum" },
                { x: "day_of_week", y: "orders", fill: "day_of_week" },
            ),
        ),
        Plot.ruleY([0]),
    ],
};
---

<Layout>
    <div style="margin-bottom: 1.5rem;">
        <a
            href="/pizzas"
            style="text-decoration: none; color: #3182ce; font-weight: bold; font-size: 0.95rem;"
            >← Retour aux Pizzas</a
        >
    </div>

    <h1
        style="text-align: center; margin-bottom: 2rem; font-size: 2rem; font-weight: bold;"
    >
        Commandes par jour de la semaine
    </h1>

    <figure
        style="display: flex; flex-direction: column; align-items: center; gap: 1rem;"
    >
        <PlotFigure options={joursOptions} />
        <figcaption
            style="max-width: 700px; text-align: center; font-size: 0.95rem; color: #555; line-height: 1.5;"
        >
            Ce graphique compare le volume total de commandes selon le jour de
            la semaine, permettant d'identifier les jours de pic d'activité dans
            la pizzeria.
        </figcaption>
    </figure>

    <div
        style="display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;"
    >
        <a
            href="/pizzas/revenus"
            style="text-decoration: none; color: #4a5568; font-weight: bold;"
            >← Article précédent</a
        >
        <a
            href="/pizzas/prix"
            style="text-decoration: none; color: #3182ce; font-weight: bold;"
            >Article suivant →</a
        >
    </div>
</Layout>
