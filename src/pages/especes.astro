---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../components/PlotFigure.astro";
import penguinsData from "../data/penguins.json";
import Layout from "../layouts/Layout.astro";

const filteredPenguins = penguinsData.map((p) => ({
    species: p.species,
}));

const barOptions = {
    title: "Répartition par espèce",
    subtitle: "Nombre total d'individus recensés",
    ariaLabel:
        "Diagramme en barres montrant la quantité de pingouins par espèce.",
    x: { label: "Espèce" },
    y: { label: "↑ Nombre d'individus" },
    marks: [
        Plot.barY(
            filteredPenguins,
            Plot.groupX({ y: "count" }, { x: "species", fill: "species" }),
        ),
        Plot.ruleY([0]),
    ],
};
---

<Layout>
    <div style="margin-bottom: 1.5rem;">
        <a
            href="/"
            style="text-decoration: none; color: #3182ce; font-weight: bold; font-size: 0.95rem;"
            >← Retour à la page d'accueil</a
        >
    </div>

    <h1 style="text-align: center; margin-bottom: 2rem;">Espèces</h1>

    <figure
        style="display: flex; flex-direction: column; align-items: center; gap: 1rem;"
    >
        <PlotFigure options={barOptions} />
        <figcaption
            style="max-width: 700px; text-align: center; font-size: 0.95rem; color: #555; line-height: 1.5;"
        >
            Ce diagramme en barres verticales indique le nombre total
            d'individus recensés pour chaque espèce de manchots. L'espèce Adelie
            est la plus représentée, suivie par les Gentoo et enfin les
            Chinstrap.
        </figcaption>
    </figure>

    <div
        style="display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;"
    >
        <a
            href="/biometrie"
            style="text-decoration: none; color: #4a5568; font-weight: bold;"
            >← Article précédent</a
        >
        <a
            href="/iles"
            style="text-decoration: none; color: #3182ce; font-weight: bold;"
            >Article suivant →</a
        >
    </div>
</Layout>
