---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<h1 class="text-3xl font-extrabold text-center mb-2">TP2 Datasets</h1>
	<p class="text-center text-gray-500 mb-10">
		Exploration de données avec Astro, Tailwind & Observable Plot
	</p>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
		<div class="card bg-base-100 shadow-lg border border-base-200">
			<div class="card-body items-center text-center">
				<div class="text-5xl mb-2">🐧</div>
				<h2 class="card-title text-xl">Pingouins</h2>
				<p class="text-sm text-gray-500">
					Analyse morphométrique des manchots de l'archipel de Palmer
					: biométrie, espèces et répartition par île.
				</p>
				<div class="card-actions mt-4">
					<a href="/penguins" class="btn btn-primary btn-sm"
						>Explorer</a
					>
				</div>
			</div>
		</div>

		<div class="card bg-base-100 shadow-lg border border-base-200">
			<div class="card-body items-center text-center">
				<div class="text-5xl mb-2">🍕</div>
				<h2 class="card-title text-xl">Pizzas</h2>
				<p class="text-sm text-gray-500">
					Données sur les pizzas : ingrédients, popularité,
					compositions et comparaisons visuelles.
				</p>
				<div class="card-actions mt-4">
					<a href="/pizzas" class="btn btn-secondary btn-sm"
						>Explorer</a
					>
				</div>
			</div>
		</div>

		<div class="card bg-base-100 shadow-lg border border-base-200">
			<div class="card-body items-center text-center">
				<div class="text-5xl mb-2">🌤️</div>
				<h2 class="card-title text-xl">Météo</h2>
				<p class="text-sm text-gray-500">
					Visualisation de données météorologiques : températures,
					précipitations et tendances saisonnières.
				</p>
				<div class="card-actions mt-4">
					<a href="/weather" class="btn btn-accent btn-sm">Explorer</a
					>
				</div>
			</div>
		</div>
	</div>
</Layout>
