---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../components/PlotFigure.astro";
import penguinsData from "../data/penguins.json";
import Layout from "../layouts/Layout.astro";

const filteredPenguins = penguinsData.map((p) => ({
    body_mass_g: p.body_mass_g,
    flipper_length_mm: p.flipper_length_mm,
    species: p.species,
}));

const scatterOptions = {
    title: "Analyse morphométrique",
    subtitle: "Masse corporelle vs Longueur des nageoires",
    ariaLabel:
        "Nuage de points montrant une corrélation positive entre la masse corporelle et la longueur des nageoires.",
    x: { label: "Masse corporelle (g) →" },
    y: { label: "↑ Longueur des nageoires (mm)" },
    color: { legend: true },
    marks: [
        Plot.frame(),
        Plot.dot(filteredPenguins, {
            x: "body_mass_g",
            y: "flipper_length_mm",
            stroke: "species",
        }),
    ],
};
---

<Layout>
    <div style="margin-bottom: 1.5rem;">
        <a
            href="/"
            style="text-decoration: none; color: #3182ce; font-weight: bold; font-size: 0.95rem;"
            >← Retour à la page d'accueil</a
        >
    </div>

    <h1 style="text-align: center; margin-bottom: 2rem;">Biométrie</h1>

    <figure
        style="display: flex; flex-direction: column; align-items: center; gap: 1rem;"
    >
        <PlotFigure options={scatterOptions} />
        <figcaption
            style="max-width: 700px; text-align: center; font-size: 0.95rem; color: #555; line-height: 1.5;"
        >
            Ce nuage de points met en relation la masse corporelle en grammes
            (axe horizontal) et la longueur des nageoires en millimètres (axe
            vertical) pour les trois espèces étudiées : Adelie (bleu), Chinstrap
            (jaune) et Gentoo (rouge). Le graphique met en évidence une
            corrélation positive globale.
        </figcaption>
    </figure>

    <div
        style="display: flex; justify-content: flex-end; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;"
    >
        <a
            href="/especes"
            style="text-decoration: none; color: #3182ce; font-weight: bold;"
            >Article suivant →</a
        >
    </div>
</Layout>
