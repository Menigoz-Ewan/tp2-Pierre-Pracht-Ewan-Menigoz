---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../components/PlotFigure.astro";
import penguinsData from "../data/penguins.json";
import Layout from "../layouts/Layout.astro";

const traductionsIles: Record<string, string> = {
    Biscoe: "Gentoo",
    Dream: "Chinstrap",
    Torgersen: "Adelie",
};

const filteredPenguins = penguinsData.map((p) => ({
    island: p.island ? traductionsIles[p.island] || p.island : p.island,
    species: p.species,
}));

const islandOptions = {
    title: "Répartition par île",
    subtitle: "Répartition des espèces par île",
    ariaLabel:
        "Diagramme en barres horizontales montrant la répartition des espèces par île.",
    marginLeft: 90,
    x: { label: "Fréquence →" },
    y: { label: null },
    color: {
        domain: ["Adelie", "Gentoo", "Chinstrap"],
        range: ["#570df8", "#f000b8", "#37cdbe"],
    },
    marks: [
        Plot.barX(
            filteredPenguins,
            Plot.groupY({ x: "count" }, { y: "island", fill: "species" }),
        ),
        Plot.ruleX([0]),
    ],
};
---

<Layout>
    <div style="margin-bottom: 1.5rem;">
        <a
            href="/"
            style="text-decoration: none; color: #3182ce; font-weight: bold; font-size: 0.95rem;"
            >← Retour à la page d'accueil</a
        >
    </div>

    <h1
        style="text-align: center; margin-bottom: 2rem; font-size: 2rem; font-weight: bold;"
    >
        Îles
    </h1>

    <figure
        style="display: flex; flex-direction: column; align-items: center; gap: 1rem;"
    >
        <PlotFigure options={islandOptions} />
        <figcaption
            style="max-width: 700px; text-align: center; font-size: 0.95rem; color: #555; line-height: 1.5;"
        >
            Ce diagramme en barres horizontales présente la fréquence des
            observations par catégorie. Chaque barre est segmentée par des
            couleurs pour refléter la composition et la répartition des
            différentes espèces au sein de chaque groupe.
        </figcaption>
    </figure>

    <div
        style="display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;"
    >
        <a
            href="/especes"
            style="text-decoration: none; color: #4a5568; font-weight: bold;"
            >← Article précédent</a
        >
    </div>
</Layout>
