---
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>TP2 - Ewan Menigoz</title>
		<style>
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
			}

			body {
				font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
				background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
				color: #334e68;
				overflow-x: hidden;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}

			.shape {
				position: fixed;
				border-radius: 50%;
				background: linear-gradient(135deg, #84c5f4 0%, #f8c8d4 100%);
				opacity: 0.5;
				z-index: -1;
				animation: float 8s ease-in-out infinite;
			}

			.shape-1 {
				width: 400px;
				height: 400px;
				top: -150px;
				left: -100px;
			}

			.shape-2 {
				width: 250px;
				height: 250px;
				bottom: 50px;
				right: -80px;
				animation-delay: -4s;
			}

			@keyframes float {
				0% {
					transform: translateY(0px) scale(1);
				}
				50% {
					transform: translateY(30px) scale(1.05);
				}
				100% {
					transform: translateY(0px) scale(1);
				}
			}

			main {
				max-width: 900px;
				margin: 3rem auto;
				padding: 2.5rem;
				background: rgba(255, 255, 255, 0.95);
				border-radius: 20px;
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
				width: 90%;
				box-sizing: border-box;
				flex: 1;
			}
		</style>
	</head>
	<body>
		<div class="shape shape-1"></div>
		<div class="shape shape-2"></div>

		<div class="navbar bg-base-100 shadow-sm px-4 sticky top-0 z-50">
			<div class="navbar-start">
				<a href="/" class="btn btn-ghost text-xl font-extrabold"
					>🐧 DataViz TP2</a
				>
			</div>
			<div class="navbar-center hidden lg:flex">
				<ul class="menu menu-horizontal px-1 gap-1">
					<li><a href="/" class="font-semibold">Accueil</a></li>
					<li>
						<details>
							<summary class="font-semibold">Pingouins</summary>
							<ul
								class="bg-base-100 rounded-box z-10 w-48 shadow-md p-2"
							>
								<li>
									<a href="/penguins/biometrie">Biométrie</a>
								</li>
								<li><a href="/penguins/especes">Espèces</a></li>
								<li><a href="/penguins/iles">Îles</a></li>
								<li><a href="/penguins/slider">Slider</a></li>
							</ul>
						</details>
					</li>
					<li>
						<details>
							<summary class="font-semibold">Pizzas</summary>
							<ul
								class="bg-base-100 rounded-box z-10 w-48 shadow-md p-2"
							>
								<li><a href="/pizzas">Vue d'ensemble</a></li>
							</ul>
						</details>
					</li>
					<li>
						<details>
							<summary class="font-semibold">Météo</summary>
							<ul
								class="bg-base-100 rounded-box z-10 w-48 shadow-md p-2"
							>
								<li><a href="/weather">Vue d'ensemble</a></li>
							</ul>
						</details>
					</li>
				</ul>
			</div>
			<div class="navbar-end">
				<div class="dropdown dropdown-end lg:hidden">
					<div
						tabindex="0"
						role="button"
						class="btn btn-ghost btn-circle"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M4 6h16M4 12h16M4 18h7"></path>
						</svg>
					</div>
					<ul
						tabindex="0"
						class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 shadow p-2"
					>
						<li><a href="/">Accueil</a></li>
						<li>
							<span class="menu-title">Pingouins</span>
							<ul>
								<li>
									<a href="/penguins/biometrie">Biométrie</a>
								</li>
								<li><a href="/penguins/especes">Espèces</a></li>
								<li><a href="/penguins/iles">Îles</a></li>
								<li><a href="/penguins/slider">Slider</a></li>
							</ul>
						</li>
						<li>
							<span class="menu-title">Pizzas</span>
							<ul>
								<li><a href="/pizzas">Vue d'ensemble</a></li>
							</ul>
						</li>
						<li>
							<span class="menu-title">Météo</span>
							<ul>
								<li><a href="/weather">Vue d'ensemble</a></li>
							</ul>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>
